{
  "openapi": "3.0.0",
  "info": {
    "title": "Janora API",
    "description": "Residential Access Management Platform",
    "version": "1.0",
    "contact": {
      "name": "Janora Team",
      "email": "support@janora.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Development Server"
    }
